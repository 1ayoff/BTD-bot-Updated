# copy this to .env and fill it in. never commit .env
DISCORD_TOKEN=

# your discord user id, lets you use ,status (optional, defaults to the app owner)
OWNER_ID=

# change the prefix if you want (default is ,)
PREFIX=,

# turns on ,fm - get a key at https://www.last.fm/api/account/create
LASTFM_API_KEY=

# optional, only if you're running a status page
HEARTBEAT_URL=
HEARTBEAT_TOKEN=

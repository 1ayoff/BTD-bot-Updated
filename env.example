# Copy to .env and fill in. NEVER commit .env to GitHub.
DISCORD_TOKEN=

# Your Discord user ID (Developer Mode -> right-click yourself -> Copy User ID). Needed for ,status
OWNER_ID=

# Optional: enables ,fm  (get one at https://www.last.fm/api/account/create)
LASTFM_API_KEY=

# Optional: status page heartbeat
HEARTBEAT_URL=
HEARTBEAT_TOKEN=
